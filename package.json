{
  "name": "set",
  "version": "0.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "bun scripts/write_env.ts && expo start --dev-client --clear",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:dev:android": "eas build -e development -p android --local --non-interactive",
    "build:prev:android": "eas build -e preview -p android --local --non-interactive",
    "build:prod:android": "eas build -e production -p android --local --non-interactive",
    "build:dev:ios": "eas build -e development -p ios --local --non-interactive",
    "build:prev:ios": "eas build -e preview -p ios --local --non-interactive",
    "build:prod:ios": "eas build -e production -p ios --local --non-interactive",
    "prebuild": "expo prebuild",
    "bump": "bun scripts/bump_version.ts",
    "ts": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format"
  },
  "dependencies": {
    "@expo-google-fonts/geist-mono": "^0.4.2",
    "@expo-google-fonts/gfs-didot": "^0.4.1",
    "@expo-google-fonts/libre-barcode-39": "^0.4.3",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@formatjs/intl-datetimeformat": "6.18.2",
    "@formatjs/intl-displaynames": "6.8.13",
    "@formatjs/intl-getcanonicallocales": "2.5.6",
    "@formatjs/intl-listformat": "7.7.13",
    "@formatjs/intl-locale": "4.2.13",
    "@formatjs/intl-numberformat": "8.15.6",
    "@formatjs/intl-pluralrules": "5.4.6",
    "@formatjs/intl-relativetimeformat": "11.4.13",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@reeq/react-native-pdf417": "^2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/query-sync-storage-persister": "5.90.7",
    "@tanstack/react-query": "5.90.5",
    "@tanstack/react-query-persist-client": "5.90.7",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "ky": "1.12.0",
    "nativewind": "latest",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "3.3.3",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-vision-camera": "5.2.3",
    "react-native-vision-camera-skia": "5.2.3",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "3.3.1",
    "zod": "4.1.12",
