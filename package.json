  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@biomejs/biome": "2.2.6",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.10",
    "tailwindcss": "^3.4.0",
    "typescript": "~6.0.3",
    "yargs": "^18.0.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "private": true,
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ]
}
